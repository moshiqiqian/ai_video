{
  "duration": 48,
  "fps": 24,
  "lines": [
    {
      "id": "l1",
      "t0": 0.9,
      "t1": 3.7,
      "text": "这不是剪辑出来的片子。",
      "dur": 2.25
    },
    {
      "id": "l2",
      "t0": 5.2,
      "t1": 9.78,
      "text": "从一句话开始，六步，全部由代码完成。",
      "dur": 4.03
    },
    {
      "id": "l3",
      "t0": 10.4,
      "t1": 13.82,
      "text": "立项，定风格、时长和语言。",
      "dur": 2.87
    },
    {
      "id": "l4",
      "t0": 15.2,
      "t1": 18.42,
      "text": "文案，拆成能对齐的句子。",
      "dur": 2.67
    },
    {
      "id": "l5",
      "t0": 20.0,
      "t1": 23.52,
      "text": "分镜，每个镜头都有明确的秒数。",
      "dur": 2.97
    },
    {
      "id": "l6",
      "t0": 24.8,
      "t1": 28.6,
      "text": "配音，一句一个文件，字幕跟着走。",
      "dur": 3.25
    },
    {
      "id": "l7",
      "t0": 29.6,
      "t1": 34.24,
      "text": "混音，旁白、配乐、音效，一条时间轴。",
      "dur": 4.09
    },
    {
      "id": "l8",
      "t0": 34.59,
      "t1": 38.37,
      "text": "渲染，一千多帧，一帧一帧算出来。",
      "dur": 3.23
    },
    {
      "id": "l9",
      "t0": 39.2,
      "t1": 41.5,
      "text": "改一行，重出一版。",
      "dur": 1.75
    },
    {
      "id": "l10",
      "t0": 44.2,
      "t1": 47.95,
      "text": "这套流程，已经跑在这台机器上。",
      "dur": 3.2
    }
  ],
